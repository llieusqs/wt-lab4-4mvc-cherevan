@model List<ProjectTask>
@{
    ViewData["Title"] = "Задачи (карточки)";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">📋 Задачи IT-проектов</h1>
        <div>
            <span class="badge bg-primary fs-6 me-2">Всего: @Model.Count</span>
            <a asp-action="Index" class="btn btn-outline-secondary">📊 Таблица</a>
        </div>
    </div>

    <div class="row">
        @foreach (var task in Model)
        {
            var headerBg = task.Priority switch
            {
                "High" => "linear-gradient(135deg, #ff512f 0%, #dd2476 100%)",
                "Medium" => "linear-gradient(135deg, #f7971e 0%, #ffd200 100%)",
                _ => "linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)"
            };
            var priorityEmoji = task.Priority switch
            {
                "High" => "🔴",
                "Medium" => "🟡",
                _ => "🟢"
            };

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm rounded-4 border-0 overflow-hidden task-card">

                    <!-- Цветная шапка карточки -->
                    <div class="p-3 text-white"
                         style="background: @headerBg;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold">@priorityEmoji @task.Priority</span>
                            @if (task.IsCompleted)
                            {
                                <span class="badge bg-success">✔ Выполнено</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark">⏳ В работе</span>
                            }
                        </div>
                    </div>

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title fw-bold">@task.Title</h5>

                        <p class="card-text text-muted mb-1">
                            📁 <strong>Проект:</strong> @task.Project
                        </p>
                        <p class="card-text text-muted mb-1">
                            👤 <strong>Исполнитель:</strong> @task.Assignee
                        </p>
                        <p class="card-text text-muted mb-3">
                            📅 <strong>Срок:</strong> @task.DueDate.ToString("dd.MM.yyyy")
                        </p>

                        <a asp-action="Details" asp-route-id="@task.Id"
                           class="btn btn-outline-primary mt-auto">
                            Подробнее →
                        </a>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <style>
        .task-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .task-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.2) !important;
        }
    </style>
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT-проекты</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/wt_lab4_4mvc_cherevan.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Navbar с градиентом -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm app-navbar">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    📋 IT-проекты
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">🏠 Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ProjectTask" asp-action="Index">📊 Таблица</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ProjectTask" asp-action="Cards">🃏 Карточки</a>
                        </li>
                    </ul>
                    <a class="btn btn-light btn-sm fw-semibold"
                       asp-controller="ProjectTask" asp-action="Create">
                        + Добавить задачу
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <!-- Основной контент -->
    <main role="main" class="flex-grow-1 py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="app-footer py-3 mt-auto">
        <div class="container text-center small">
            © @DateTime.Now.Year — <strong>wt_lab4_4mvc_cherevan</strong>
            · <a asp-controller="Home" asp-action="Privacy">Политика конфиденциальности</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>